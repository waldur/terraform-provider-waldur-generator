// normalizeUTCTime converts +00:00 timezone suffix to Z for consistent comparison.
func normalizeUTCTime(s *string) *string {
	if s == nil {
		return nil
	}
	v := strings.Replace(*s, "+00:00", "Z", 1)
	return &v
}
