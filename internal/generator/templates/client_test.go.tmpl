func TestAuthorizationHeader(t *testing.T) {
	cases := map[string]string{
		"w_abc123":  "Bearer w_abc123",
		"c44bb36d6": "Token c44bb36d6",
	}
	for token, want := range cases {
		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			if got := r.Header.Get("Authorization"); got != want {
				t.Errorf("token %q: expected Authorization %q, got %q", token, want, got)
			}
			w.Header().Set("Content-Type", "application/json")
			w.Write([]byte(`{}`))
		}))
		c, err := NewClient(&Config{Endpoint: server.URL, Token: token})
		if err != nil {
			t.Fatalf("Failed to create client: %v", err)
		}
		if err := c.GetURL(context.Background(), "/api/", nil); err != nil {
			t.Errorf("token %q: request failed: %v", token, err)
		}
		server.Close()
	}
}

// waldurListServer serves total items the way the Waldur API paginates them:
// a Link header with rel="next" while more pages remain, X-Result-Count, and
// 404 "Invalid page." past the last page. It counts the requests it gets.
func waldurListServer(t *testing.T, total int, requests *int) *httptest.Server {
	return httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		*requests++
		if r.URL.Query().Get("state") != "OK" {
			t.Errorf("Expected state=OK, got %q", r.URL.Query().Get("state"))
		}
		page, size := 1, 10
		if v := r.URL.Query().Get("page"); v != "" {
			fmt.Sscanf(v, "%d", &page)
		}
		if v := r.URL.Query().Get("page_size"); v != "" {
			fmt.Sscanf(v, "%d", &size)
		}
		pages := (total + size - 1) / size
		if pages == 0 {
			pages = 1
		}
		if page > pages {
			w.WriteHeader(http.StatusNotFound)
			w.Write([]byte(`{"detail": "Invalid page."}`))
			return
		}
		w.Header().Set("Content-Type", "application/json")
		w.Header().Set("X-Result-Count", fmt.Sprintf("%d", total))
		links := []string{fmt.Sprintf(`<http://%s%s?page_size=%d>; rel="first"`, r.Host, r.URL.Path, size)}
		if page < pages {
			links = append(links, fmt.Sprintf(`<http://%s%s?page=%d&page_size=%d>; rel="next"`, r.Host, r.URL.Path, page+1, size))
		}
		w.Header().Set("Link", strings.Join(links, ", "))
		w.Write([]byte("["))
		for i := (page - 1) * size; i < page*size && i < total; i++ {
			if i > (page-1)*size {
				w.Write([]byte(","))
			}
			fmt.Fprintf(w, `{"uuid": "item-%d"}`, i)
		}
		w.Write([]byte("]"))
	}))
}

func TestListAll_FollowsPages(t *testing.T) {
	cases := []struct {
		total    int
		requests int
	}{
		{0, 1},
		{3, 1},
		{listPageSize, 1}, // a full last page: asking for the next one would 404
		{listPageSize + 3, 2},
		{2 * listPageSize, 2},
	}
	for _, tc := range cases {
		t.Run(fmt.Sprintf("%d items", tc.total), func(t *testing.T) {
			requests := 0
			server := waldurListServer(t, tc.total, &requests)
			defer server.Close()

			c, err := NewClient(&Config{Endpoint: server.URL, Token: "test-token"})
			if err != nil {
				t.Fatalf("Failed to create client: %v", err)
			}
			var results []map[string]interface{}
			if err := c.ListAll(context.Background(), "/api/things/", map[string]string{"state": "OK"}, &results); err != nil {
				t.Fatalf("ListAll failed: %v", err)
			}
			if len(results) != tc.total {
				t.Fatalf("Expected %d results, got %d", tc.total, len(results))
			}
			if tc.total > 0 && results[tc.total-1]["uuid"] != fmt.Sprintf("item-%d", tc.total-1) {
				t.Errorf("Unexpected last item %v", results[tc.total-1])
			}
			if requests != tc.requests {
				t.Errorf("Expected %d requests, got %d", tc.requests, requests)
			}
		})
	}
}

// An endpoint that ignores the page parameter returns its whole list every
// time. Without a next link it is read once; one that links a next page
// regardless is stopped when a page repeats the previous one.
func TestListAll_UnpaginatedEndpoint(t *testing.T) {
	for _, linkNext := range []bool{false, true} {
		t.Run(fmt.Sprintf("next link %v", linkNext), func(t *testing.T) {
			total, requests := 150, 0
			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
				requests++
				if linkNext {
					w.Header().Set("Link", `<http://example/api/things/?page=2>; rel="next"`)
				}
				w.Header().Set("Content-Type", "application/json")
				w.Write([]byte("["))
				for i := 0; i < total; i++ {
					if i > 0 {
						w.Write([]byte(","))
					}
					fmt.Fprintf(w, `{"uuid": "item-%d"}`, i)
				}
				w.Write([]byte("]"))
			}))
			defer server.Close()

			c, err := NewClient(&Config{Endpoint: server.URL, Token: "test-token"})
			if err != nil {
				t.Fatalf("Failed to create client: %v", err)
			}
			var results []map[string]interface{}
			if err := c.ListAll(context.Background(), "/api/things/", nil, &results); err != nil {
				t.Fatalf("ListAll failed: %v", err)
			}
			if len(results) != total {
				t.Errorf("Expected %d results, got %d", total, len(results))
			}
			if requests > 2 {
				t.Errorf("Expected at most 2 requests, got %d", requests)
			}
		})
	}
}

// A server that always links a next page with new items is cut off by the
// page cap with an error rather than read forever.
func TestListAll_PageCap(t *testing.T) {
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Link", `<http://example/next>; rel="next"`)
		w.Header().Set("Content-Type", "application/json")
		fmt.Fprintf(w, `[{"uuid": "page-%s"}]`, r.URL.Query().Get("page"))
	}))
	defer server.Close()

	c, err := NewClient(&Config{Endpoint: server.URL, Token: "test-token"})
	if err != nil {
		t.Fatalf("Failed to create client: %v", err)
	}
	var results []map[string]interface{}
	err = c.ListAll(context.Background(), "/api/things/", nil, &results)
	if err == nil || !strings.Contains(err.Error(), "more than") {
		t.Fatalf("Expected a page cap error, got %v", err)
	}
}

func TestHasNextLink(t *testing.T) {
	cases := map[string]bool{
		``: false,
		`<http://x/?page_size=5>; rel="first", <http://x/?page=11&page_size=5>; rel="last"`:                              false,
		`<http://x/?page_size=5>; rel="first", <http://x/?page=2&page_size=5>; rel="next", <http://x/?page=11>; rel="last"`: true,
		`<http://x/?page=2>;rel="next"`: true,
		`<http://x/?page=1>; rel="prev"`: false,
	}
	for link, want := range cases {
		if got := hasNextLink(link); got != want {
			t.Errorf("hasNextLink(%q) = %v, want %v", link, got, want)
		}
	}
}

func TestList(t *testing.T) {
	// Create a test server
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		// Verify query parameters
		if r.URL.Query().Get("name") != "test-project" {
			t.Errorf("Expected name=test-project, got %s", r.URL.Query().Get("name"))
		}
		
		// Return test data
		w.Header().Set("Content-Type", "application/json")
		w.WriteHeader(http.StatusOK)
		w.Write([]byte(`[{"uuid": "abc-123", "name": "test-project"}]`))
	}))
	defer server.Close()

	// Create client
	client, err := NewClient(&Config{
		Endpoint: server.URL,
		Token:    "test-token",
	})
	if err != nil {
		t.Fatalf("Failed to create client: %v", err)
	}

	// Test ListWithFilter
	var results []map[string]interface{}
	filters := map[string]string{
		"name": "test-project",
	}
	
	err = client.List(context.Background(), "/api/projects/", filters, &results)
	if err != nil {
		t.Fatalf("ListWithFilter failed: %v", err)
	}

	// Verify results
	if len(results) != 1 {
		t.Fatalf("Expected 1 result, got %d", len(results))
	}
	
	if results[0]["uuid"] != "abc-123" {
		t.Errorf("Expected uuid=abc-123, got %v", results[0]["uuid"])
	}
	
	if results[0]["name"] != "test-project" {
		t.Errorf("Expected name=test-project, got %v", results[0]["name"])
	}
}

func TestGetByUUID_WithTemplate(t *testing.T) {
	// Create a test server
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		// Verify path has UUID substituted
		expectedPath := "/api/projects/abc-123/"
		if r.URL.Path != expectedPath {
			t.Errorf("Expected path %s, got %s", expectedPath, r.URL.Path)
		}
		
		// Return test data
		w.Header().Set("Content-Type", "application/json")
		w.WriteHeader(http.StatusOK)
		w.Write([]byte(`{"uuid": "abc-123", "name": "test-project"}`))
	}))
	defer server.Close()

	// Create client
	client, err := NewClient(&Config{
		Endpoint: server.URL,
		Token:    "test-token",
	})
	if err != nil {
		t.Fatalf("Failed to create client: %v", err)
	}

	// Test GetByUUID with templated path
	var result map[string]interface{}
	err = client.Get(context.Background(), "/api/projects/{uuid}/", "abc-123", &result)
	if err != nil {
		t.Fatalf("GetByUUID failed: %v", err)
	}

	// Verify result
	if result["uuid"] != "abc-123" {
		t.Errorf("Expected uuid=abc-123, got %v", result["uuid"])
	}
}

func TestUpdate_WithTemplate(t *testing.T) {
